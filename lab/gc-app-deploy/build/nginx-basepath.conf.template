# __BASE_PATH__ 는 빌드 때 BASE_PATH 값으로 바뀐다 (Dockerfile.web-basepath)
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  sendfile on;

  # 읽기 전용 컨테이너 — 임시 파일은 /tmp 로
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path       /tmp/proxy_temp;
  fastcgi_temp_path     /tmp/fastcgi_temp;
  uwsgi_temp_path       /tmp/uwsgi_temp;
  scgi_temp_path        /tmp/scgi_temp;

  server {
    listen 8080;
    root /usr/share/nginx/html;

    # 쿠버 준비 확인(헬스체크)용
    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

    # 화면 라우팅 — 없는 경로는 index.html 로 (SPA)
    location __BASE_PATH__ { try_files $uri $uri/ __BASE_PATH__index.html; }
  }
}
