# 화면(빌드된 정적 파일 dist/) 이미지 — 외부 경로(base)를 빌드 때 정한다: --build-arg BASE_PATH=/sample/
# 프론트 빌드 설정(Vite base · 라우터 basename)도 같은 경로여야 한다.
FROM public.ecr.aws/docker/library/nginx:1.27-alpine
ARG BASE_PATH=/

COPY nginx-basepath.conf.template /tmp/nginx.conf.template
RUN sed "s#__BASE_PATH__#${BASE_PATH}#g" /tmp/nginx.conf.template > /etc/nginx/nginx.conf \
 && rm -f /tmp/nginx.conf.template /etc/nginx/conf.d/default.conf
COPY dist/ /usr/share/nginx/html${BASE_PATH}

# root 아님(nginx 사용자 101) · 포트 8080 · 쓰기는 /tmp 만
USER 101
EXPOSE 8080
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
